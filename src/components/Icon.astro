---
/**
 * Jeu d'icônes du site : traits 24×24, style linéaire cohérent.
 * Centralisé ici pour éviter les SVG dupliqués dans le markup.
 */
type IconName =
  | 'arrow-right'
  | 'arrow-down'
  | 'chevron-down'
  | 'shield'
  | 'origin'
  | 'engrave'
  | 'clock'
  | 'gift'
  | 'check';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;

const stroked: Record<string, string> = {
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  'arrow-down': '<line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>',
  'chevron-down': '<polyline points="6 9 12 15 18 9"/>',
  shield: '<path d="M12 2L4 7v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V7l-8-5z"/>',
  origin:
    '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  engrave:
    '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  gift:
    '<polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
};

const widths: Record<string, string> = {
  'arrow-right': '2.5',
  'arrow-down': '2.5',
  origin: '1.8',
  engrave: '1.8',
  clock: '1.8',
  gift: '1.8',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={widths[name] ?? '2'}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={stroked[name]}
/>
