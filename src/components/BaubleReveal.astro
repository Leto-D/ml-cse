---
/**
 * Section « boule de Noël bois » : effet 3D piloté par le défilement.
 *
 * La section fait 250vh et contient un conteneur `sticky` de 100svh. La
 * progression 0→1 est mesurée sur cette hauteur par l'îlot React. Aucun
 * défilement n'est intercepté : la scène lit une position, elle ne la pilote
 * pas. `svh` et non `vh`, sinon la barre d'adresse d'iOS fait sauter le calage.
 *
 * Le hero n'est pas touché : cette section vient après lui, coffret compris.
 *
 * Trois choses vivent ici, et pas dans le canevas :
 *  — le texte commercial, en HTML, lisible par les crawlers et les lecteurs
 *    d'écran (le canevas est décoratif et `aria-hidden`) ;
 *  — le repli statique, deux figures SVG posées dès le premier octet : c'est
 *    à la fois le poster (le bloc n'est jamais vide) ET le repli servi sous
 *    `prefers-reduced-motion` comme en l'absence de WebGL ;
 *  — le script de garde (scripts/bauble.ts), qui ne pèse que quelques
 *    centaines d'octets et ne tire React, three et la scène que si le
 *    mouvement est autorisé, que WebGL répond, et que la section approche.
 *    Sous `reduce` ou sans WebGL : zéro octet chargé.
 */
import type { Client } from '~/types';
import Icon from './Icon.astro';
import { POSTER } from './bauble/poster.gen';

interface Props {
  client: Client;
}

const { client } = Astro.props;
const bauble = client.bauble;

// Sérialisé pour le script de garde. Le composant ne connaît aucune valeur en
// dur : décor, logo et nom viennent tous de la config du client.
const data = bauble && {
  artwork: bauble.artwork,
  logoUrl: bauble.logoUrl,
  companyName: bauble.companyName,
  backEngraving: bauble.backEngraving,
};
---

{
  bauble && (
    <section class="bauble" data-bauble aria-labelledby="bauble-title">
      <div class="bauble-stage">
        <div class="container">
          <div class="bauble-inner">
            <div class="bauble-copy reveal">
              <span class="hero-eyebrow">{bauble.eyebrow}</span>
              <h2 id="bauble-title">{bauble.title}</h2>
              <p class="bauble-subtitle">{bauble.subtitle}</p>
              <a href="#contact" class="pill-btn">
                Demander un devis
                <Icon name="arrow-down" />
              </a>
            </div>

            <div class="bauble-media">
              {/* Repli statique : assemblée et désassemblée, côte à côte. Pas
                  une version ralentie de l'animation — deux états, immobiles. */}
              <div class="bauble-fallback" aria-hidden="true">
                {/* Les tracés sont ceux de la scène 3D — mêmes fichiers SVG,
                    même générateur —, simplifiés pour la taille d'un poster.
                    Ils sont définis une seule fois et réemployés. Règle de
                    remplissage `evenodd` : ce sont de vrais vides, pas des
                    formes peintes. */}
                <svg class="bauble-fig" viewBox={`0 0 ${POSTER.W} ${POSTER.H}`} focusable="false">
                  <defs>
                    <path id="bauble-front" fill-rule="evenodd" d={POSTER.front.cut} />
                    <path id="bauble-back" fill-rule="evenodd" d={POSTER.back.cut} />
                    {/* Le médaillon en aplats, comme sur l'objet : coiffe
                        brûlée, visage en bois nu, traits sombres. Les couches
                        `wood` prennent `currentColor`, donc la teinte de la
                        plaque qui les porte — les deux figures n'ont pas
                        exactement le même bois. */}
                    <g id="bauble-medal" fill-rule="evenodd">
                      {POSTER.front.medallion.map((layer) => (
                        <path
                          d={layer.d}
                          fill={layer.tone === 'burn' ? '#5C3E22' : 'currentColor'}
                          fill-opacity={layer.tone === 'burn' ? 0.62 : 1}
                        />
                      ))}
                    </g>
                    <radialGradient id="bauble-shade" cx="0.36" cy="0.28" r="0.8">
                      <stop offset="0" stop-color="#F6E3C4" stop-opacity="0.5" />
                      <stop offset="1" stop-color="#8A6238" stop-opacity="0.42" />
                    </radialGradient>
                  </defs>

                  {/* La plaque arrière : c'est elle qu'on aperçoit par la
                      fenêtre de l'avant, et elle est plus sombre. */}
                  <use href="#bauble-back" fill="#8A6238" />
                  {/* La plaque avant, par-dessus, et son médaillon gravé. */}
                  <use href="#bauble-front" fill="#D8B489" />
                  <use href="#bauble-medal" color="#D8B489" />
                  <use href="#bauble-front" fill="url(#bauble-shade)" />
                </svg>

                <svg
                  class="bauble-fig bauble-fig--wide"
                  viewBox={`0 0 ${2 * POSTER.W} ${POSTER.H}`}
                  focusable="false"
                >
                  {/* Chaque plaque est doublée d'une copie plus sombre, décalée :
                      la frange qui dépasse est la tranche du bois. C'est elle
                      qui dit que l'objet est massif et non imprimé. */}
                  <g transform="translate(21 26) scale(0.79)">
                    <use href="#bauble-front" fill="#9A7146" transform="translate(7 7)" />
                    <use href="#bauble-front" fill="#E8CFA6" />
                    <use href="#bauble-medal" color="#E8CFA6" />
                  </g>
                  <g transform="translate(221 26) scale(0.79)">
                    {/* Retournée : c'est son DOS qu'on découvre, donc sa
                        découpe est en miroir. Le bloc gravé, lui, se lit à
                        l'endroit — il n'est pas dans le miroir. */}
                    <g transform={`translate(${POSTER.W} 0) scale(-1 1)`}>
                      <use href="#bauble-back" fill="#9A7146" transform="translate(-7 7)" />
                      <use href="#bauble-back" fill="#EBD3AE" />
                    </g>
                    {/* Logo, filet, mention d'origine, nom : tout tient sous la
                        ligne des portes, seule bande où cette plaque est pleine. */}
                    <circle
                      cx="100"
                      cy="181"
                      r="9"
                      fill="none"
                      stroke="#5C3E22"
                      stroke-opacity="0.5"
                      stroke-width="3"
                    />
                    <g fill="#5C3E22" fill-opacity="0.5">
                      <rect x="72" y="193" width="56" height="2.6" rx="1.3" />
                      <rect x="58" y="199" width="84" height="7" rx="3.5" />
                      <rect x="66" y="208.5" width="68" height="8" rx="4" />
                    </g>
                  </g>
                  {/* La mention ne vise QUE la plaque de droite : son bloc gravé
                      est le seul placeholder qui reste. Le reste est le dessin
                      réel du client. */}
                  <text
                    x="300"
                    y="248"
                    text-anchor="middle"
                    font-size="11"
                    letter-spacing="2.4"
                    fill="#5C3E22"
                    fill-opacity="0.55"
                  >
                    PLACEHOLDER
                  </text>
                </svg>
              </div>

              <div class="bauble-canvas" data-bauble-mount aria-hidden="true" role="presentation" />
              <script
                is:inline
                type="application/json"
                data-bauble-props
                set:html={JSON.stringify(data)}
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* La hauteur défilable. Le conteneur `sticky` vit dedans. */
  .bauble {
    position: relative;
    height: 250vh;
  }

  .bauble-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .bauble-stage > .container {
    width: 100%;
  }

  .bauble-inner {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: var(--sp-7);
  }

  .bauble-copy h2 {
    margin: var(--sp-2) 0 var(--sp-4);
  }
  .bauble-subtitle {
    max-width: 46ch;
    margin-bottom: var(--sp-5);
  }

  /*
    Le cadre qui accueille la scène. Le repli et le canevas s'y superposent.
    Plus large que haut, et ce n'est pas un choix graphique : en fin de course
    l'objet fait deux plaques côte à côte, donc près de deux fois plus large
    que haut. Dans un cadre carré il faudrait le réduire d'un tiers pour le
    faire tenir, et tout le geste se jouerait petit.
  */
  .bauble-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 72svh;
    margin-inline: auto;
  }

  .bauble-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    transition: opacity 0.45s ease;
  }
  .bauble-fig {
    width: auto;
    height: min(100%, 46svh);
    max-width: 46%;
  }
  /* L'éclaté tient deux plaques côte à côte : il lui faut toute la largeur. */
  .bauble-fig--wide {
    max-width: 96%;
  }
  .bauble[data-bauble-live] .bauble-fig--wide {
    display: none;
  }
  /*
    Deux figures par défaut : c'est le repli complet, celui qui doit rester
    lisible sans JavaScript, sans WebGL, et sous mouvement réduit.
    `data-bauble-live` n'est posé que si la scène va effectivement venir : le
    repli se réduit alors à la boule fermée, qui sert de poster.
  */

  .bauble-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Posé à la première image réellement rendue. Tant qu'il manque — mouvement
     réduit, WebGL absent, chunk en échec — le repli reste, sans message. */
  .bauble[data-bauble-ready] .bauble-fallback {
    opacity: 0;
    pointer-events: none;
  }
  .bauble[data-bauble-ready] .bauble-canvas {
    opacity: 1;
  }
  /*
    Le div que r3f crée DANS .bauble-canvas est fabriqué en JavaScript : il ne
    porte pas l'attribut de scope d'Astro. Toute règle qui le vise doit passer
    par :global(), sinon elle ne s'applique jamais (même piège que les
    suggestions de /lab/logo).
  */
  .bauble-canvas :global(canvas) {
    display: block;
  }

  @media (max-width: 960px) {
    .bauble {
      height: 200vh;
    }
    .bauble-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--sp-5);
    }
    .bauble-subtitle {
      margin-inline: auto;
    }
    .bauble-media {
      max-height: 46svh;
    }
    .bauble-fig {
      height: min(100%, 30svh);
    }
  }

  /* Aucune animation sous mouvement réduit : les deux états, côte à côte,
     immobiles. L'îlot n'est de toute façon jamais monté. */
  @media (prefers-reduced-motion: reduce) {
    .bauble {
      height: auto;
    }
    .bauble-stage {
      position: static;
      height: auto;
      padding: var(--sp-9) 0;
    }
    .bauble-fallback {
      position: static;
      transition: none;
      flex-wrap: wrap;
    }
    .bauble-media {
      aspect-ratio: auto;
      max-height: none;
    }
    .bauble-fig {
      height: auto;
      max-width: 44%;
    }
    /*
      Après `.bauble-fig`, et pas avant : à spécificité égale c'est la dernière
      règle qui gagne, et l'éclaté se retrouverait plafonné à 44 % comme la
      boule fermée. Il porte deux plaques côte à côte, donc deux fois la
      largeur pour la même hauteur : à 44 % il devient illisible. Passé 100 %
      à eux deux, les deux figures se rangent l'une sous l'autre.
    */
    .bauble-fig--wide {
      max-width: 92%;
    }
  }
</style>

<script>
  import { initBauble } from '~/scripts/bauble';
  initBauble();
</script>
