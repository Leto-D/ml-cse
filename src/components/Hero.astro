---
import type { Client } from '~/types';
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
import GiftBox from './GiftBox.astro';

interface Props {
  client: Client;
}

const { client } = Astro.props;
const { hero } = client;

// Le site est publié dans un sous-dossier : tout lien interne doit passer
// par BASE_URL, sinon il pointe à la racine du domaine.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const secondaryHref = hero.ctaSecondary
  ? `${base}/${hero.ctaSecondary.href.replace(/^\//, '')}`
  : undefined;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="hero-eyebrow">{hero.eyebrow}</span>
      <h1 id="hero-title">
        <span data-hero-lead>{hero.titleLead}</span><br />
        <span data-hero-join>{hero.titleJoin}</span><span
          class="accent"
          data-hero-accent>{hero.titleAccent}</span
        >
      </h1>
      <p class="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-actions">
        <a href="#produits" class="pill-btn">
          {hero.cta}
          <Icon name="arrow-down" />
        </a>
        {
          hero.ctaSecondary && (
            <a href={secondaryHref} class="pill-btn is-ghost">
              {hero.ctaSecondary.label}
              <Icon name="engrave" />
            </a>
          )
        }
      </div>
    </div>

    <GiftBox />
  </div>
  <Ornament class="hero-deco" />
</section>
