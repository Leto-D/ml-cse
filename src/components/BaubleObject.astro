---
/**
 * La boule de Noël en bois rendue dans le hero.
 *
 * Ce composant est nu : pas de section, pas de texte, pas de mise en page.
 * La section qui l'héberge est le hero (Hero.astro), qui fait 250vh et
 * épingle son contenu ; le coffret s'y efface pendant que la boule
 * apparaît, et le désassemblage enchaîne (voir scripts/gift-box.ts et
 * BaubleCanvas.tsx). Trois choses vivent ici :
 *
 *  — le repli statique, deux figures SVG posées dès le premier octet : c'est
 *    à la fois le poster (le bloc n'est jamais vide) ET le repli servi sous
 *    `prefers-reduced-motion` comme en l'absence de WebGL ou de JavaScript ;
 *  — le point de montage du canevas (`data-bauble-mount`) et les données
 *    sérialisées pour le script de garde ;
 *  — le script de garde (scripts/bauble.ts), qui ne pèse que quelques
 *    centaines d'octets et ne tire React, three et la scène que si le
 *    mouvement est autorisé, que WebGL répond, et que la section approche.
 *    Sous `reduce` ou sans WebGL : zéro octet chargé.
 *
 * Piège de scope Astro : les ancêtres porteurs d'état (`[data-bauble-live]`,
 * `[data-bauble-ready]`, `.is-swapped`) sont rendus par Hero.astro, pas ici.
 * Toute règle qui les vise doit passer par `:global()`, sinon Astro la scope
 * à ce composant et elle ne s'applique jamais, en silence.
 */
import type { Client } from '~/types';
import { POSTER } from './bauble/poster.gen';

interface Props {
  client: Client;
}

const { client } = Astro.props;
const bauble = client.bauble;

// Sérialisé pour le script de garde. Le composant ne connaît aucune valeur en
// dur : décor, logo et nom viennent tous de la config du client.
const data = bauble && {
  artwork: bauble.artwork,
  logoUrl: bauble.logoUrl,
  companyName: bauble.companyName,
  backEngraving: bauble.backEngraving,
};
---

{
  bauble && (
    <div class="bauble-object">
      {/* Repli statique : assemblée et désassemblée, côte à côte. Pas
          une version ralentie de l'animation — deux états, immobiles. */}
      <div class="bauble-fallback" aria-hidden="true">
        {/* Les tracés sont ceux de la scène 3D — mêmes fichiers SVG,
            même générateur —, simplifiés pour la taille d'un poster.
            Ils sont définis une seule fois et réemployés. Règle de
            remplissage `evenodd` : ce sont de vrais vides, pas des
            formes peintes. */}
        <svg class="bauble-fig" viewBox={`0 0 ${POSTER.W} ${POSTER.H}`} focusable="false">
          <defs>
            <path id="bauble-front" fill-rule="evenodd" d={POSTER.front.cut} />
            <path id="bauble-back" fill-rule="evenodd" d={POSTER.back.cut} />
            {/* Le médaillon en aplats, comme sur l'objet : coiffe
                brûlée, visage en bois nu, traits sombres. Les couches
                `wood` prennent `currentColor`, donc la teinte de la
                plaque qui les porte — les deux figures n'ont pas
                exactement le même bois. */}
            <g id="bauble-medal" fill-rule="evenodd">
              {POSTER.front.medallion.map((layer) => (
                <path
                  d={layer.d}
                  fill={layer.tone === 'burn' ? '#5C3E22' : 'currentColor'}
                  fill-opacity={layer.tone === 'burn' ? 0.62 : 1}
                />
              ))}
            </g>
            <radialGradient id="bauble-shade" cx="0.36" cy="0.28" r="0.8">
              <stop offset="0" stop-color="#F6E3C4" stop-opacity="0.5" />
              <stop offset="1" stop-color="#8A6238" stop-opacity="0.42" />
            </radialGradient>
          </defs>

          {/* La plaque arrière : c'est elle qu'on aperçoit par la
              fenêtre de l'avant, et elle est plus sombre. */}
          <use href="#bauble-back" fill="#8A6238" />
          {/* La plaque avant, par-dessus, et son médaillon gravé. */}
          <use href="#bauble-front" fill="#D8B489" />
          <use href="#bauble-medal" color="#D8B489" />
          <use href="#bauble-front" fill="url(#bauble-shade)" />
        </svg>

        <svg
          class="bauble-fig bauble-fig--wide"
          viewBox={`0 0 ${2 * POSTER.W} ${POSTER.H}`}
          focusable="false"
        >
          {/* Chaque plaque est doublée d'une copie plus sombre, décalée :
              la frange qui dépasse est la tranche du bois. C'est elle
              qui dit que l'objet est massif et non imprimé. */}
          <g transform="translate(21 26) scale(0.79)">
            <use href="#bauble-front" fill="#9A7146" transform="translate(7 7)" />
            <use href="#bauble-front" fill="#E8CFA6" />
            <use href="#bauble-medal" color="#E8CFA6" />
          </g>
          <g transform="translate(221 26) scale(0.79)">
            {/* Retournée : c'est son DOS qu'on découvre, donc sa
                découpe est en miroir. Le bloc gravé, lui, se lit à
                l'endroit — il n'est pas dans le miroir. */}
            <g transform={`translate(${POSTER.W} 0) scale(-1 1)`}>
              <use href="#bauble-back" fill="#9A7146" transform="translate(-7 7)" />
              <use href="#bauble-back" fill="#EBD3AE" />
            </g>
            {/* Logo, filet, mention d'origine, nom : tout tient sous la
                ligne des portes, seule bande où cette plaque est pleine. */}
            <circle
              cx="100"
              cy="181"
              r="9"
              fill="none"
              stroke="#5C3E22"
              stroke-opacity="0.5"
              stroke-width="3"
            />
            <g fill="#5C3E22" fill-opacity="0.5">
              <rect x="72" y="193" width="56" height="2.6" rx="1.3" />
              <rect x="58" y="199" width="84" height="7" rx="3.5" />
              <rect x="66" y="208.5" width="68" height="8" rx="4" />
            </g>
          </g>
          {/* La mention ne vise QUE la plaque de droite : son bloc gravé
              est le seul placeholder qui reste. Le reste est le dessin
              réel du client. */}
          <text
            x="300"
            y="248"
            text-anchor="middle"
            font-size="11"
            letter-spacing="2.4"
            fill="#5C3E22"
            fill-opacity="0.55"
          >
            PLACEHOLDER
          </text>
        </svg>
      </div>

      <div class="bauble-canvas" data-bauble-mount aria-hidden="true" role="presentation" />
      <script
        is:inline
        type="application/json"
        data-bauble-props
        set:html={JSON.stringify(data)}
      />
    </div>
  )
}

<style>
  /*
    Par défaut, l'objet est posé dans le flux : coffret au-dessus, figures en
    dessous. C'est la présentation servie sans JavaScript, sans WebGL et sous
    mouvement réduit — jamais un bloc vide, jamais un état caché posé dans le
    CSS. Tant que la scène n'est pas confirmée, `.bauble-object` ne recouvre
    donc pas le coffret : il s'empile sous lui.
  */
  .bauble-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
    transition: opacity 0.45s ease;
  }
  .bauble-fig {
    width: auto;
    height: auto;
    max-width: 44%;
  }
  /* L'éclaté tient deux plaques côte à côte : il lui faut toute la largeur.
     Après `.bauble-fig`, et pas avant : à spécificité égale c'est la dernière
     règle qui gagne, et l'éclaté se retrouverait plafonné comme la boule
     fermée. Passé 100 % à eux deux, les deux figures se rangent l'une sous
     l'autre. */
  .bauble-fig--wide {
    max-width: 92%;
  }

  .bauble-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /*
    La scène va venir (attribut posé par le script de garde, jamais par
    défaut) : l'objet recouvre le cadre du hero, encore invisible — le coffret
    est à l'honneur. L'éclaté disparaît, le repli se réduit à la boule fermée,
    qui sert de poster.
  */
  :global([data-bauble-live]) .bauble-object {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(26px) scale(0.94);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  :global([data-bauble-live]) .bauble-fallback {
    position: absolute;
    inset: 0;
    flex-wrap: nowrap;
  }
  :global([data-bauble-live]) .bauble-fig {
    height: min(100%, 46svh);
    max-width: 46%;
  }
  :global([data-bauble-live]) .bauble-fig--wide {
    display: none;
  }

  /*
    Le coffret s'est effacé (classe posée au défilement par scripts/gift-box.ts) :
    la boule monte de 26px, revient à l'échelle et apparaît en fondu. C'est la
    passation — un fondu croisé, pas une extraction.
  */
  :global(.is-swapped) .bauble-object {
    opacity: 1;
    transform: none;
  }

  /* Posé à la première image réellement rendue. Tant qu'il manque — mouvement
     réduit, WebGL absent, chunk en échec — le repli reste, sans message. */
  :global([data-bauble-ready]) .bauble-fallback {
    opacity: 0;
    pointer-events: none;
  }
  :global([data-bauble-ready]) .bauble-canvas {
    opacity: 1;
  }
  /*
    Le div que r3f crée DANS .bauble-canvas est fabriqué en JavaScript : il ne
    porte pas l'attribut de scope d'Astro. Toute règle qui le vise doit passer
    par :global(), sinon elle ne s'applique jamais.
  */
  .bauble-canvas :global(canvas) {
    display: block;
  }

  @media (max-width: 960px) {
    :global([data-bauble-live]) .bauble-fig {
      height: min(100%, 30svh);
    }
  }
</style>

<script>
  import { initBauble } from '~/scripts/bauble';
  initBauble();
</script>
