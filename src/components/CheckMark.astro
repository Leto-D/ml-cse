---
/**
 * Marqueur de case à cocher : carré arrondi + coche qui se dessine.
 * Purement décoratif : l'état vient toujours de l'<input> qui le précède.
 */
---

<span class="mu-check" aria-hidden="true">
  <svg viewBox="0 0 18 18" focusable="false">
    <polyline
      class="mu-tick"
      points="4.5,9.6 7.4,12.7 13.6,5.4"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></polyline>
  </svg>
</span>
