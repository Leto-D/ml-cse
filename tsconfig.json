{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "archive"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    // React est le seul framework JSX du projet : les .tsx de l'îlot 3D sont
    // compilés avec sa transformation automatique.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
